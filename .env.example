# Copy to .env and adjust — or simply run ./run.sh / .\run.ps1, which creates .env from this file on
# first start (it never overwrites an existing .env). Placeholders only — never commit real secrets.

# ---------------------------------------------------------------- local launcher (run.sh / run.ps1)
# How the launcher provides PostgreSQL: "docker" (starts the `db` service in docker-compose.yml)
# or "local" (uses an existing PostgreSQL server reachable at DATABASE_URL).
SDP_DB_MODE="docker"
# Credentials for the Docker database container (the launcher generates a random password).
SDP_DB_USER="sdp"
SDP_DB_PASSWORD="change-me-local-db-password"
SDP_DB_NAME="sdp_dev"
# Host port for the Docker database, bound to 127.0.0.1 only.
SDP_DB_PORT="5433"
# Port for the web application (`next dev -p PORT`). Keep APP_URL in sync when changing it.
PORT="3000"
# Interface the dev server listens on. 127.0.0.1 keeps it private to this computer; set "0.0.0.0" only
# if you deliberately want other devices on your network to reach it (demo accounts are public!).
SDP_HOST="127.0.0.1"
# Open the default browser once the application is ready ("false" to disable).
SDP_OPEN_BROWSER="true"

# ---------------------------------------------------------------- application
# PostgreSQL connection string (Prisma format). Must match the SDP_DB_* values in docker mode.
DATABASE_URL="postgresql://sdp:change-me-local-db-password@127.0.0.1:5433/sdp_dev?schema=public"

# Separate database for automated tests (wiped by the test suite).
TEST_DATABASE_URL="postgresql://sdp:change-me-local-db-password@127.0.0.1:5433/sdp_test?schema=public"

# Public origin of the app; used for CSRF origin checks. On Render, RENDER_EXTERNAL_URL is used if unset.
APP_URL="http://localhost:3000"
# Extra origins allowed to send state-changing requests (comma separated, optional)
ALLOWED_ORIGINS=""

# Demonstration mode: shows the demo banner and the sample-account picker on the sign-in page.
# The launcher enables it only in the .env it creates for local development. Keep "false" for any
# non-demonstration deployment.
DEMO_MODE="false"
# Password assigned to seeded demo accounts (demo/dev only). The launcher uses the documented
# local default Demo@SDP2026; change it here BEFORE the first seed if you prefer another value.
DEMO_PASSWORD="change-me-demo-password-1"

# Protected document storage directory (must NOT be inside /public)
STORAGE_DIR="./storage/documents"

# Session lifetime in hours (idle timeout is 1 hour)
SESSION_TTL_HOURS="8"
# Force Secure cookies (defaults to true when NODE_ENV=production)
# SECURE_COOKIES="true"

# Email channel: "simulated" (records deliveries as SIMULATED, sends nothing) or "disabled"
EMAIL_MODE="simulated"

# External verification provider: "demo" (clearly-labelled simulated adapter) or "none"
VERIFICATION_PROVIDER="none"

# Interval for `npm run monitor:watch` (minutes)
MONITOR_INTERVAL_MINUTES="60"

# Optional: fix the seed reference date (YYYY-MM-DD) for fully reproducible demo dates
# SEED_REFERENCE_DATE="2026-10-26"
